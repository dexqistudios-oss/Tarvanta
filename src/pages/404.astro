---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import Strata from '@/components/art/Strata.astro';
import { navigation } from '@/config/site';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex
>
  <section class="page-wrap pb-16 pt-16 md:pb-20 md:pt-28" aria-labelledby="nf-title">
    <p class="t-label">Error 404</p>
    <h1 id="nf-title" class="t-display mt-6 max-w-[16ch]">This page could not be found.</h1>
    <p class="t-lede mt-8 max-w-[40ch] text-graphite">
      It may have moved, or the address may contain a typing error. Try one of these instead.
    </p>

    <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-4">
      <li><Button href="/">Go to the home page</Button></li>
      {navigation.map((item) => (
        <li class="flex items-center"><a href={item.href} class="link">{item.label}</a></li>
      ))}
    </ul>
  </section>
  <div class="h-40 md:h-56" aria-hidden="true">
    <Strata stems={[]} seed={9} layers={10} />
  </div>
</BaseLayout>
