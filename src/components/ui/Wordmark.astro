---
/**
 * Tarvanta wordmark: a small strata mark (three layers, one rising stem)
 * set beside the name in Newsreader. Colour follows `currentColor`.
 */
export interface Props {
  class?: string;
  /** Hide the text and keep only the mark. */
  markOnly?: boolean;
}
const { class: className = '', markOnly = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
    <path d="M2 15.5h18M2 19h18M4 12h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <path d="M11 12V3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <circle cx="11" cy="3" r="1.9" fill="var(--color-bronze)" />
  </svg>
  {!markOnly && (
    <span class="font-display text-[1.45rem] leading-none tracking-[-0.01em]" style="font-weight: 420;">
      Tarvanta
    </span>
  )}
</span>
