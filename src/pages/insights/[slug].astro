---
/**
 * Insights article template.
 * One page is generated per entry in src/content/insights/.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { articleSchema, breadcrumbSchema } from '@/components/seo/schema';
import { getInsights, formatDate, readingTime } from '@/lib/content';

export const getStaticPaths = (async () => {
  const entries = await getInsights();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      next: entries[i + 1] ?? null,
      prev: entries[i - 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { entry, next, prev } = Astro.props;
const { Content } = await render(entry);
const { title, summary, topic, published, updated, author, cover, coverAlt, draft } = entry.data;
const path = `/insights/${entry.id}/`;
const ogImage = cover?.src;
---

<BaseLayout
  title={title}
  description={summary}
  type="article"
  image={ogImage}
  imageAlt={coverAlt}
  publishedTime={published}
  modifiedTime={updated}
  noindex={draft}
  schema={[
    articleSchema({ title, description: summary, path, published, updated, author, image: ogImage }),
    breadcrumbSchema([
      { name: 'Insights', path: '/insights/' },
      { name: title, path },
    ]),
  ]}
>
  <article aria-labelledby="article-title">
    <header class="page-wrap pb-12 pt-14 md:pb-16 md:pt-24">
      <nav aria-label="Breadcrumb" class="t-small text-graphite">
        <ol class="flex flex-wrap gap-x-2">
          <li><a href="/insights/" class="link">Insights</a></li>
          <li aria-hidden="true">/</li>
          <li>{topic}</li>
        </ol>
      </nav>

      <h1 id="article-title" class="t-display mt-8 max-w-[20ch]">{title}</h1>

      <div class="mt-10 grid gap-8 md:grid-cols-12">
        <p class="t-lede text-graphite md:col-span-7">{summary}</p>
        <dl class="t-small grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 self-end text-graphite md:col-span-3 md:col-start-10">
          <dt>By</dt><dd class="text-charcoal">{author}</dd>
          <dt>Published</dt>
          <dd class="text-charcoal"><time datetime={published.toISOString()}>{formatDate(published)}</time></dd>
          {updated && (
            <>
              <dt>Updated</dt>
              <dd class="text-charcoal"><time datetime={updated.toISOString()}>{formatDate(updated)}</time></dd>
            </>
          )}
          <dt>Length</dt><dd class="text-charcoal">{readingTime(entry.body)}</dd>
        </dl>
      </div>

      {draft && (
        <p class="mt-8 border border-dashed border-olive/60 bg-paper px-4 py-3 t-small text-olive-deep">
          Draft: visible in development only. Set <code>draft: false</code> to publish.
        </p>
      )}
    </header>

    {cover && (
      <figure class="page-wrap mb-16 md:mb-24">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 960, 1280, 1680]}
          sizes="(min-width: 84rem) 80rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/8] w-full object-cover"
        />
      </figure>
    )}

    <div class="page-wrap border-t border-stone pt-14 md:pt-20">
      <div class="grid md:grid-cols-12">
        <div class="article-body article-first md:col-span-8 md:col-start-3 lg:col-span-7 lg:col-start-4">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <nav aria-label="More insights" class="page-wrap mt-24 border-t border-stone md:mt-32">
    <div class="grid gap-px sm:grid-cols-2">
      <div class="py-10 sm:pr-8">
        {prev && (
          <>
            <p class="t-small text-graphite">Newer</p>
            <a href={`/insights/${prev.id}/`} class="t-subheading mt-2 block hover:text-olive">{prev.data.title}</a>
          </>
        )}
      </div>
      <div class="border-t border-stone py-10 sm:border-l sm:border-t-0 sm:pl-8">
        {next ? (
          <>
            <p class="t-small text-graphite">Older</p>
            <a href={`/insights/${next.id}/`} class="t-subheading mt-2 block hover:text-olive">{next.data.title}</a>
          </>
        ) : (
          <>
            <p class="t-small text-graphite">Archive</p>
            <a href="/insights/" class="t-subheading mt-2 block hover:text-olive">All insights</a>
          </>
        )}
      </div>
    </div>
  </nav>
  <div class="h-24 md:h-32" aria-hidden="true"></div>
</BaseLayout>

<style>
  /* Opening paragraph set a step larger to draw the reader in */
  :global(.article-first > p:first-child) {
    font-size: 1.22em;
    line-height: 1.5;
    color: var(--color-charcoal);
  }
</style>
