---
const title = 'Tarvanta — Insight into Action';
const description = 'Tarvanta is an independent, insights-led venture platform connecting strategic thinking, business storytelling and meaningful action.';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#16182A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://www.tarvanta.in/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://www.tarvanta.in/" />
    <meta property="og:image" content="https://www.tarvanta.in/founder-insight-into-action.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,350;6..72,400;6..72,500;6..72,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root{--ink:#16182A;--khadi:#F4EFE6;--paper:#FBF8F3;--laterite:#A8442A;--ember:#E07A55;--muted:#aaa49d;--line:rgba(244,239,230,.2);--serif:'Newsreader',Georgia,serif;--sans:'DM Sans',Arial,sans-serif;--ease:cubic-bezier(.2,.75,.25,1)}
      *{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--paper);scroll-padding-top:90px}body{margin:0;color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}body.menu-open{overflow:hidden}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--ember);outline-offset:4px}.wrap{width:min(1320px,calc(100% - 9vw));margin:auto}
      .hero{min-height:min(900px,100svh);position:relative;display:flex;align-items:stretch;overflow:hidden;background:#171821;color:var(--khadi);isolation:isolate}.hero-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 42%;opacity:.9;transform:scale(1.055);animation:heroImage 1.8s var(--ease) both}.hero:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(13,14,22,.97) 0%,rgba(13,14,22,.88) 31%,rgba(13,14,22,.48) 57%,rgba(13,14,22,.08) 83%),linear-gradient(0deg,rgba(13,14,22,.62),transparent 48%)}.hero:after{content:"";position:absolute;z-index:2;left:4.2%;top:0;bottom:0;width:1px;background:rgba(244,239,230,.18)}
      .hero-inner{position:relative;z-index:3;display:flex;flex-direction:column;justify-content:space-between;padding:30px 0 42px;min-height:min(900px,100svh)}.topline{display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid rgba(244,239,230,.2);padding-bottom:20px}.brand{display:flex;align-items:center;gap:12px;font:500 27px/1 var(--serif);letter-spacing:.035em}.brand img{width:32px;height:32px}.nav{display:flex;align-items:center;gap:clamp(18px,3vw,42px)}.nav a{font-size:9px;letter-spacing:.19em;text-transform:uppercase;color:#e6ded4;transition:color .25s}.nav a:hover{color:#e7a58b}.nav .nav-contact{border:1px solid rgba(244,239,230,.48);padding:12px 16px}.menu-toggle{display:none;background:none;border:0;color:var(--khadi);font-size:10px;letter-spacing:.15em;text-transform:uppercase}
      .hero-grid{display:grid;grid-template-columns:minmax(400px,1.08fr) minmax(300px,.72fr);align-items:center;gap:5vw;padding:55px 0 45px}.hero-copy{max-width:720px}.eyebrow,.micro,.section-label{font-size:10px;letter-spacing:.25em;text-transform:uppercase;font-weight:600}.eyebrow{color:#e7c7ad;margin:0 0 27px;display:flex;align-items:center;gap:13px}.eyebrow:before{content:"";width:34px;height:1px;background:#d8b69d}.hero h1{font:350 clamp(4.4rem,8.8vw,8.7rem)/.86 var(--serif);letter-spacing:-.06em;margin:0 0 26px;max-width:8ch}.hero h1 span{display:block;color:#e7c7ad;font-style:italic;font-weight:350}.descriptor{font-size:10px;letter-spacing:.19em;text-transform:uppercase;color:#e7d9ca;margin:0 0 30px;line-height:2}.intro{font:400 clamp(1.25rem,2vw,1.7rem)/1.38 var(--serif);color:#f0e9df;max-width:570px;margin:0}.hero-actions{display:flex;align-items:center;gap:26px;margin-top:36px}.primary-link{display:inline-flex;align-items:center;gap:24px;padding:15px 19px;background:var(--khadi);color:var(--ink);font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;transition:transform .3s var(--ease),background .3s}.primary-link:hover{transform:translateY(-4px);background:#fff}.text-link{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:#e7c7ad}.text-link span{display:inline-block;margin-left:8px;transition:transform .3s}.text-link:hover span{transform:translate(4px,-4px)}
      .founder-card{position:relative;justify-self:end;width:min(100%,440px);padding:18px;border:1px solid rgba(244,239,230,.35);background:rgba(22,24,42,.2);backdrop-filter:blur(5px);transform:translateY(25px);opacity:0;animation:cardIn 1s .6s var(--ease) forwards}.founder-card:before{content:"";position:absolute;inset:8px;border:1px solid rgba(244,239,230,.22);pointer-events:none}.founder-card img{display:block;width:100%;aspect-ratio:1.34;object-fit:cover;object-position:center 42%;filter:saturate(.82)}.founder-card-caption{display:flex;justify-content:space-between;gap:12px;padding:17px 4px 3px;align-items:end}.founder-card-caption small{display:block;font-size:8px;letter-spacing:.22em;text-transform:uppercase;color:#d8b69d;margin-bottom:7px}.founder-card-caption strong{font:400 24px var(--serif)}.founder-card-caption span{font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:#ded5ca;text-align:right;line-height:1.7}
      .hero-bottom{display:flex;align-items:end;justify-content:space-between;gap:30px;border-top:1px solid var(--line);padding-top:20px}.signature{font:600 15px var(--sans);letter-spacing:.32em}.signature small{display:block;font:500 8px var(--sans);letter-spacing:.28em;margin-top:8px;color:#d6c7b7}.scroll-note{font-size:9px;letter-spacing:.2em;text-transform:uppercase;color:#d6c7b7;display:flex;gap:12px;align-items:center}.scroll-note:after{content:"";width:42px;height:1px;background:#d6c7b7;transition:width .3s}.scroll-note:hover:after{width:66px}
      .orbital{position:absolute;z-index:2;right:7%;top:17%;width:210px;aspect-ratio:1;border:1px solid rgba(244,239,230,.22);border-radius:50%;opacity:.7;pointer-events:none;animation:orbit 28s linear infinite}.orbital:before,.orbital:after{content:"";position:absolute;border:1px solid rgba(244,239,230,.18);border-radius:50%;inset:18px;transform:rotate(55deg) scaleX(.45)}.orbital:after{inset:-18px;transform:rotate(-35deg) scaleX(.7)}.orbital i{position:absolute;width:7px;height:7px;border-radius:50%;background:var(--ember);top:15%;left:23%;box-shadow:0 0 20px var(--ember)}
      .section{padding:clamp(82px,11vw,150px) 0}.section-label{color:var(--laterite);margin:0 0 24px}.section h2{font:350 clamp(2.8rem,6vw,6rem)/.98 var(--serif);letter-spacing:-.045em;margin:0;max-width:11ch}.section h2 em{font-weight:350;color:var(--laterite)}.lead{font:400 clamp(1.25rem,2vw,1.65rem)/1.45 var(--serif);max-width:620px;color:#444451;margin:0}
      .vision-grid{display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:start}.vision-copy{padding-top:8px}.vision-copy p{font:400 18px/1.65 var(--serif);color:#55545b;margin:0 0 20px;max-width:560px}
      .mission{background:var(--ink);color:var(--khadi);position:relative;overflow:hidden}.mission:after{content:"T";position:absolute;right:3vw;bottom:-.55em;font:350 34vw/.8 var(--serif);color:rgba(244,239,230,.035);pointer-events:none}.mission .wrap{position:relative;z-index:1}.mission .section-label{color:#e7a58b}.mission-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw}.mission h2{max-width:10ch}.mission-copy{padding-top:12px}.mission-copy p{font:400 clamp(1.4rem,2.2vw,2rem)/1.45 var(--serif);color:#e8e1d8;margin:0 0 24px;max-width:650px}.mission-note{border-top:1px solid var(--line);padding-top:22px;color:#c9c1b8;font-size:10px;letter-spacing:.16em;text-transform:uppercase}
      .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:75px;border-top:1px solid #d9d2c7}.pillar{padding:28px 28px 0 0;position:relative;transition:transform .5s var(--ease)}.pillar:hover{transform:translateY(-7px)}.pillar+.pillar{padding-left:28px;border-left:1px solid #d9d2c7}.number{font:350 15px var(--serif);color:var(--laterite)}.pillar h3{font:400 30px var(--serif);margin:30px 0 12px}.pillar p{font-size:14px;line-height:1.75;color:#66636a;max-width:320px;margin:0}
      .insights{background:#eee8de}.insights-head{display:flex;justify-content:space-between;align-items:end;gap:35px}.insights-head h2{max-width:9ch}.insight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:64px}.insight-card{min-height:270px;padding:28px;border:1px solid #d2c9bd;display:flex;flex-direction:column;justify-content:space-between;background:rgba(251,248,243,.4);position:relative;overflow:hidden;transition:transform .5s var(--ease),background .4s,border-color .4s}.insight-card:after{content:"↗";position:absolute;right:25px;top:17px;font-size:18px;color:var(--laterite);opacity:0;transform:translate(-8px,8px);transition:all .35s}.insight-card:hover{transform:translateY(-8px);background:var(--paper);border-color:#bcae9e}.insight-card:hover:after{opacity:1;transform:none}.insight-card .micro{color:var(--laterite)}.insight-card h3{font:400 clamp(1.6rem,2.5vw,2.3rem)/1.08 var(--serif);max-width:12ch;margin:35px 0}.insight-card p{font-size:12px;line-height:1.6;color:#6a6670;margin:0}.editorial-note{margin-top:24px;color:#82766b}
      .founder{display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw;align-items:center}.founder-photo-wrap{position:relative;max-width:520px}.founder-photo{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center 42%;display:block;filter:saturate(.86)}.founder-photo-wrap:after{content:"";position:absolute;inset:18px -18px -18px 18px;border:1px solid #c9b9a8;z-index:-1}.founder-copy h2{max-width:9ch}.founder-copy .lead{margin-top:28px}.founder-role{font-size:9px;text-transform:uppercase;letter-spacing:.25em;color:var(--laterite);margin:30px 0 12px}.founder-name{font:400 24px var(--serif);margin:0}
      .contact{background:var(--laterite);color:#fff8ef;position:relative;overflow:hidden}.contact:before{content:"";position:absolute;width:52vw;aspect-ratio:1;border:1px solid rgba(255,255,255,.14);border-radius:50%;right:-18vw;top:-24vw;box-shadow:0 0 0 55px rgba(255,255,255,.025),0 0 0 110px rgba(255,255,255,.02)}.contact .wrap{position:relative;z-index:1}.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:8vw;align-items:start}.contact .section-label{color:#f4d5c8}.contact h2{max-width:10ch}.contact-intro{font:400 19px/1.5 var(--serif);max-width:460px;color:#f5dfd5;margin:28px 0 0}.contact-meta{font-size:9px;letter-spacing:.15em;text-transform:uppercase;color:#f4d5c8;margin-top:34px;line-height:2}.contact-form{display:grid;grid-template-columns:1fr 1fr;gap:18px 16px;padding-top:10px}.field{display:flex;flex-direction:column;gap:9px}.field.full{grid-column:1/-1}.field label{font-size:9px;letter-spacing:.17em;text-transform:uppercase;color:#f7e3d9}.field input,.field textarea{width:100%;border:0;border-bottom:1px solid rgba(255,255,255,.5);border-radius:0;background:transparent;color:#fff8ef;padding:12px 0;font:400 16px var(--serif);outline:none;transition:border-color .25s}.field input::placeholder,.field textarea::placeholder{color:rgba(255,248,239,.65)}.field input:focus,.field textarea:focus{border-color:#fff}.field textarea{min-height:110px;resize:vertical}.field input:-webkit-autofill{-webkit-text-fill-color:#fff8ef;transition:background-color 9999s}.form-bottom{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:8px}.submit-btn{display:inline-flex;align-items:center;gap:22px;border:1px solid #fff8ef;background:#fff8ef;color:var(--laterite);padding:15px 20px;font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;cursor:pointer;transition:transform .25s,background .25s}.submit-btn:hover{transform:translateY(-3px);background:white}.submit-btn:disabled{opacity:.6;cursor:wait;transform:none}.form-privacy{font-size:9px;color:#f5d8cc;line-height:1.6;max-width:190px}.form-status{grid-column:1/-1;min-height:20px;font-size:12px;line-height:1.5;color:#fff8ef}.hp-field{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;overflow:hidden!important}
      footer{background:var(--ink);color:var(--khadi);padding:30px 0}.footer-inner{display:flex;justify-content:space-between;align-items:center;gap:24px}.footer-brand{font:500 23px var(--serif);letter-spacing:.04em}.footer-brand span{display:block;font:500 9px var(--sans);letter-spacing:.24em;color:#bdb5aa;margin-top:7px}.footer-right{text-align:right}.footer-links{display:flex;gap:22px;justify-content:flex-end;margin-bottom:10px}.footer-links a{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#d6cfc5}.copyright{font-size:9px;color:#bdb5aa;letter-spacing:.08em}
      .reveal{opacity:0;transform:translateY(28px);transition:opacity .85s var(--ease),transform .85s var(--ease)}.reveal.is-visible{opacity:1;transform:translateY(0)}.reveal-delay-1{transition-delay:.12s}.reveal-delay-2{transition-delay:.24s}.reveal-delay-3{transition-delay:.36s}.word-reveal{display:inline-block;overflow:hidden;vertical-align:bottom}.word-reveal span{display:inline-block;transform:translateY(110%);animation:wordUp .9s .25s var(--ease) forwards}
      @keyframes heroImage{to{transform:scale(1)}}@keyframes cardIn{to{opacity:1;transform:translateY(0)}}@keyframes orbit{to{transform:rotate(360deg)}}@keyframes wordUp{to{transform:translateY(0)}}
      @media(max-width:900px){.hero-grid{grid-template-columns:1fr .72fr;gap:3vw}.hero h1{font-size:clamp(4rem,8vw,6.8rem)}.founder-card{width:100%}.founder-card-caption strong{font-size:20px}.orbital{width:150px}.contact-grid{gap:5vw}}
      @media(max-width:700px){.wrap{width:calc(100% - 42px)}.hero{min-height:900px}.hero-photo{object-position:61% center}.hero:before{background:linear-gradient(90deg,rgba(13,14,22,.94),rgba(13,14,22,.72) 62%,rgba(13,14,22,.36)),linear-gradient(0deg,rgba(13,14,22,.65),transparent 70%)}.hero-inner{min-height:900px;padding:24px 0 28px}.topline{padding-bottom:16px}.brand{font-size:24px}.brand img{width:28px;height:28px}.menu-toggle{display:block}.nav{position:fixed;z-index:10;inset:0;background:var(--ink);display:flex;flex-direction:column;justify-content:center;gap:30px;opacity:0;visibility:hidden;transform:translateY(-10px);transition:all .3s}.nav.open{opacity:1;visibility:visible;transform:none}.nav a{font-size:13px}.nav .nav-contact{padding:15px 20px}.hero-grid{grid-template-columns:1fr;gap:30px;padding:65px 0 35px}.hero-copy{max-width:540px}.hero h1{font-size:clamp(4.2rem,16vw,7rem)}.descriptor{font-size:8px;letter-spacing:.14em;margin-bottom:24px}.intro{font-size:1.3rem;max-width:460px}.hero-actions{margin-top:25px;gap:18px;flex-wrap:wrap}.founder-card{justify-self:start;width:min(78%,350px);padding:11px;margin-left:auto;margin-top:-5px}.founder-card img{aspect-ratio:1.6}.founder-card-caption{padding-top:10px}.founder-card-caption strong{font-size:18px}.founder-card-caption span{font-size:7px}.orbital{width:100px;right:7%;top:22%}.hero-bottom{align-items:start}.scroll-note{display:none}.vision-grid,.mission-grid,.founder,.contact-grid{grid-template-columns:1fr;gap:35px}.vision-copy{padding:0}.section h2{max-width:12ch}.pillars{grid-template-columns:1fr;margin-top:48px}.pillar,.pillar+.pillar{padding:25px 0;border-left:0;border-bottom:1px solid #d9d2c7}.pillar h3{margin:15px 0 8px}.insights-head{display:block}.insight-grid{grid-template-columns:1fr;margin-top:38px}.insight-card{min-height:220px}.founder-photo-wrap{width:86%;margin:0 18px 18px 0}.founder-photo{aspect-ratio:5/4}.founder-copy{order:-1}.contact-form{grid-template-columns:1fr}.field.full,.form-bottom,.form-status{grid-column:1}.form-bottom{align-items:flex-start;flex-direction:column}.footer-inner{align-items:flex-start;flex-direction:column}.footer-right{text-align:left}.footer-links{justify-content:flex-start;flex-wrap:wrap}.copyright{line-height:1.6}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.reveal{opacity:1;transform:none}}
    </style>
  </head>
  <body>
    <header class="hero" id="top">
      <img class="hero-photo" src="/founder-insight-into-action.webp" alt="Tarvanta founder Lalit Yadav, photographed in a thoughtful moment." fetchpriority="high" />
      <div class="orbital" aria-hidden="true"><i></i></div>
      <div class="wrap hero-inner">
        <div class="topline">
          <a class="brand" href="#top" aria-label="Tarvanta home"><img src="/tarvanta-symbol.svg" alt="" /><span>TARVANTA</span></a>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu +</button>
          <nav class="nav" id="site-nav" aria-label="Main navigation">
            <a href="#vision">The vision</a><a href="#perspective">Our approach</a><a href="#founder">Founder</a><a class="nav-contact" href="#connect">Get in touch ↗</a>
          </nav>
        </div>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">An independent global venture platform</p>
            <h1>Insight <span>into action.</span></h1>
            <p class="descriptor">Insights &nbsp;|&nbsp; Business storytelling &nbsp;|&nbsp; Meaningful action</p>
            <p class="intro">We connect strategic thinking, clear perspectives and entrepreneurial ambition to shape what comes next.</p>
            <div class="hero-actions"><a class="primary-link" href="#vision">Discover Tarvanta <span aria-hidden="true">↗</span></a><a class="text-link" href="#connect">Start a conversation <span aria-hidden="true">↗</span></a></div>
          </div>
          <aside class="founder-card" aria-label="Founder profile">
            <img src="/founder-insight-into-action.webp" alt="Lalit Yadav, founder of Tarvanta." />
            <div class="founder-card-caption"><div><small>Founder</small><strong>Lalit Yadav</strong></div><span>Independent thinking<br/>Meaningful progress</span></div>
          </aside>
        </div>
        <div class="hero-bottom"><div class="signature">TARVANTA<small>THINK DEEPLY. BUILD THOUGHTFULLY.</small></div><a class="scroll-note" href="#vision">Explore the thinking</a></div>
      </div>
    </header>
    <main>
      <section class="section" id="vision"><div class="wrap vision-grid"><div class="reveal"><p class="section-label">01 / Our vision</p><h2>A more considered way to build <em>what comes next.</em></h2></div><div class="vision-copy reveal reveal-delay-1"><p class="lead">We envision a world where ambitious ideas are shaped by deeper insight, thoughtful strategy and meaningful execution.</p><p>We look beyond conventional boundaries — across markets, industries and emerging possibilities — to recognise where understanding can become opportunity.</p><p>Our ambition is not simply to create more businesses. It is to help shape ventures with purpose, relevance and the potential to make a lasting contribution.</p></div></div></section>
      <section class="section mission" id="mission"><div class="wrap mission-grid"><div class="reveal"><p class="section-label">02 / Our mission</p><h2>Turning understanding into possibility.</h2></div><div class="mission-copy reveal reveal-delay-1"><p>To explore opportunities, develop informed perspectives and build ventures with long-term relevance.</p><p>Through research, strategic thinking, business storytelling and an entrepreneurial mindset, Tarvanta is being developed as a connected platform for ideas and independent businesses to evolve.</p><div class="mission-note">Insight · Perspective · Venture</div></div></div></section>
      <section class="section" id="perspective"><div class="wrap"><div class="reveal"><p class="section-label">03 / How we think</p><h2>Clarity is not a shortcut. It is a <em>discipline.</em></h2></div><div class="pillars"><article class="pillar reveal"><span class="number">01</span><h3>Insight</h3><p>Look beyond the obvious. Understand the forces, patterns and opportunities shaping markets, industries and people.</p></article><article class="pillar reveal reveal-delay-1"><span class="number">02</span><h3>Perspective</h3><p>Connect information, experience and independent thinking to form a clearer view of what matters — and why.</p></article><article class="pillar reveal reveal-delay-2"><span class="number">03</span><h3>Venture</h3><p>Translate informed conviction into purposeful ideas, independent businesses and opportunities worth pursuing.</p></article></div></div></section>
      <section class="section insights" id="insights"><div class="wrap"><div class="insights-head reveal"><div><p class="section-label">04 / Perspectives</p><h2>Ideas worth looking at <em>closely.</em></h2></div><p class="lead">A growing collection of observations, research and considered perspectives.</p></div><div class="insight-grid"><article class="insight-card reveal"><span class="micro">01 / Global outlook</span><h3>Markets, shifts & emerging opportunity</h3><p>Exploring the signals shaping industries and the possibilities beyond them.</p></article><article class="insight-card reveal reveal-delay-1"><span class="micro">02 / Strategic thinking</span><h3>From complexity to clarity</h3><p>Making sense of difficult questions, competing priorities and consequential choices.</p></article><article class="insight-card reveal reveal-delay-2"><span class="micro">03 / Venture thinking</span><h3>Building with intent</h3><p>Ideas, operating principles and the work of turning a meaningful problem into a venture.</p></article></div><p class="micro editorial-note reveal">EDITORIAL SERIES — COMING SOON</p></div></section>
      <section class="section" id="founder"><div class="wrap founder"><div class="founder-photo-wrap reveal"><img class="founder-photo" src="/founder-insight-into-action.webp" alt="Lalit Yadav, founder of Tarvanta." loading="lazy" /></div><div class="founder-copy reveal reveal-delay-1"><p class="section-label">05 / The founder's perspective</p><h2>Thoughtful questions. <em>Practical progress.</em></h2><p class="lead">I help leaders make sense of complex challenges and communicate ideas that drive decisions. At Tarvanta, I bring together strategic thinking, visual clarity and a belief in practical solutions that create real impact.</p><p class="founder-role">Founder</p><p class="founder-name">Lalit Yadav</p></div></div></section>
      <section class="section contact" id="connect"><div class="wrap contact-grid"><div class="reveal"><p class="section-label">06 / Begin a conversation</p><h2>Good things begin with a <em>conversation.</em></h2><p class="contact-intro">Whether you have a question, an idea or a potential collaboration in mind, we'd be glad to hear from you.</p><p class="contact-meta">For partnerships · Ideas · Enquiries<br/>Tarvanta · India / Global</p></div>
        <form class="contact-form reveal reveal-delay-1" id="contact-form" action="https://formsubmit.co/ajax/tarvanta.hq@outlook.com" method="POST">
          <input type="hidden" name="_subject" value="New enquiry from Tarvanta website" /><input type="hidden" name="_template" value="table" /><input type="hidden" name="_captcha" value="true" />
          <div class="hp-field" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" type="text" name="_honey" tabindex="-1" autocomplete="off" /></div>
          <div class="field"><label for="contact-name">Your name *</label><input id="contact-name" name="name" type="text" placeholder="Name" autocomplete="name" required minlength="2" /></div>
          <div class="field"><label for="contact-email">Email address *</label><input id="contact-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required /></div>
          <div class="field full"><label for="contact-company">Organisation <span aria-hidden="true">(optional)</span></label><input id="contact-company" name="organisation" type="text" placeholder="Company or organisation" autocomplete="organization" /></div>
          <div class="field full"><label for="contact-message">What would you like to discuss? *</label><textarea id="contact-message" name="message" placeholder="Tell us a little about it..." required minlength="10"></textarea></div>
          <div class="form-bottom"><button class="submit-btn" id="submit-btn" type="submit">Send your message <span aria-hidden="true">↗</span></button><p class="form-privacy">Your details will only be used to respond to your enquiry.</p></div>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div></section>
    </main>
    <footer><div class="wrap footer-inner"><div class="footer-brand">TARVANTA<span>INSIGHT INTO ACTION.</span></div><div class="footer-right"><div class="footer-links"><a href="#vision">Vision</a><a href="#founder">Founder</a><a href="#connect">Contact</a></div><div class="copyright">© {new Date().getFullYear()} Tarvanta. All rights reserved.</div></div></div></footer>
    <script>
      const nav = document.querySelector<HTMLElement>('#site-nav');
      const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      menuToggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('open') ?? false;
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        menuToggle.textContent = isOpen ? 'Close −' : 'Menu +';
        document.body.classList.toggle('menu-open', isOpen);
      });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
        nav.classList.remove('open'); menuToggle?.setAttribute('aria-expanded','false');
        if(menuToggle) menuToggle.textContent='Menu +';
        document.body.classList.remove('menu-open');
      }));
      const revealItems = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver(entries => {
          entries.forEach(entry => { if(entry.isIntersecting){entry.target.classList.add('is-visible');revealObserver.unobserve(entry.target);} });
        }, {threshold:.12,rootMargin:'0px 0px -45px 0px'});
        revealItems.forEach(item => revealObserver.observe(item));
      } else revealItems.forEach(item => item.classList.add('is-visible'));
      const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
      const submitButton = document.querySelector<HTMLButtonElement>('#submit-btn');
      const formStatus = document.querySelector<HTMLElement>('#form-status');
      const honeypot = contactForm?.querySelector<HTMLInputElement>('[name="_honey"]');
      if (contactForm && submitButton && formStatus && honeypot) contactForm.addEventListener('submit', async event => {
        event.preventDefault();
        if (!contactForm.reportValidity()) return;
        if (honeypot.value) return;
        submitButton.disabled = true;
        submitButton.innerHTML = 'Sending…';
        formStatus.textContent = 'Sending your message securely…';
        try {
          const response = await fetch(contactForm.action, {method:'POST',body:new FormData(contactForm),headers:{'Accept':'application/json'}});
          const result = await response.json();
          if (!response.ok || String(result.success) !== 'true') throw new Error(result.message || 'The message could not be sent.');
          contactForm.reset();
          formStatus.textContent = 'Thank you. Your message has been sent. We’ll be in touch soon.';
          submitButton.innerHTML = 'Message sent ✓';
        } catch(error) {
          formStatus.textContent = 'We couldn’t send your message just now. Please email tarvanta.hq@outlook.com directly.';
          submitButton.disabled = false;
          submitButton.innerHTML = 'Try again ↗';
        }
      });
    </script>
  </body>
</html>